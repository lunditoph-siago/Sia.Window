<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Window</PackageId>
    <PackageDescription>Backend-agnostic windowing components and events for Sia ECS.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sia" Version="2.1.3" />
  </ItemGroup>

</Project>
